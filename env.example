# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=asd
DB_PASSWORD=asd

# Azure OpenAI Configuration
AZURE_GPT_API_KEY=your-azure-gpt-api-key-here
AZURE_GPT_ENDPOINT=https://your-instance.openai.azure.com/openai/deployments/gpt-4/chat/completions?api-version=2024-08-01-preview
AZURE_EMBEDDING_BASEURL=https://your-instance.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your-azure-embedding-api-key-here
AZURE_EMBEDDING_ENDPOINT=https://your-instance.azure.com/openai/deployments/text-embedding-3-large/embeddings?api-version=2023-05-15

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_FULL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Mistral AI Configuration
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-2501

# LangSmith Configuration (optional, for debugging and monitoring)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="your-langsmith-project-name-here"
